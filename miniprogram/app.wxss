page { background: #10191a; color: #eef7f3; font-size: 28rpx; }
button { border-radius: 18rpx; font-size: 28rpx; margin-top: 20rpx; }
button::after { border: none; }
button[disabled] { opacity: .45; }
.container { padding: 56rpx 32rpx; }
.eyebrow { color: #a6debf; font-size: 22rpx; letter-spacing: 3rpx; }
.title { font-size: 48rpx; font-weight: 700; margin-top: 18rpx; }
.subtitle { color: #adbfba; line-height: 1.8; margin: 20rpx 0 30rpx; }
.card { background: #1c2929; border: 1rpx solid #344441; padding: 30rpx; border-radius: 26rpx; margin-top: 28rpx; }
.row { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; }
.card-title { font-size: 31rpx; font-weight: 600; }
.muted { color: #adbfba; font-size: 24rpx; line-height: 1.8; margin-top: 14rpx; }
.badge { color: #a6debf; font-size: 22rpx; white-space: nowrap; }
.primary { background: #b5edcb; color: #10291d; font-weight: 600; }
.secondary, .device { background: #30423e; color: #e4f3eb; }
.link { color: #b5edcb; display: inline-block; margin-top: 20rpx; font-size: 24rpx; }
textarea { box-sizing: border-box; width: 100%; height: 270rpx; padding: 24rpx; margin-top: 24rpx; background: #10191a; border-radius: 16rpx; color: #eef7f3; line-height: 1.6; }
.error, .over { color: #ffb5a7; }
.error { padding: 24rpx; line-height: 1.7; }
.success { margin-top: 20rpx; color: #b5edcb; }
.footer { text-align: center; color: #91aaa0; font-size: 24rpx; line-height: 1.9; margin-top: 36rpx; }
.privacy-mask { position: fixed; inset: 0; background: rgba(0,0,0,.75); display: flex; align-items: center; justify-content: center; z-index: 100; }
.privacy-card { width: 580rpx; box-sizing: border-box; padding: 36rpx; border-radius: 24rpx; background: #1c2929; }
